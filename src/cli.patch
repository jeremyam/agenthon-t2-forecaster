+def _rationale_fhs(
+    unit_id: str,
+    asof: str,
+    assets: list[str],
+    horizons: list[int],
+    n_draws: int,
+    stats: dict[str, Any],
+    text_dir: pathlib.Path,
+) -> str:
+    n_docs = len(list(text_dir.glob("*.txt"))) if text_dir.is_dir() else 0
+    rows = "\n".join(
+        f"| {x} | {stats['anchor'][x]:.6g} | {stats['cur_sd'][x]:.4g} | {stats['lr_sd'][x]:.4g} | "
+        f"{stats['drift'][x]:.3g} |"
+        for x in assets
+    )
+    p = stats["params"]
+    return f"""# Forecast rationale — {unit_id}
+
+As of **{asof}**: joint draws for {", ".join(assets)} at horizon(s)
+{", ".join(str(h) for h in horizons)} business days. {n_draws} draws.
+
+## Method (text-blind statistical engine)
+
+Filtered historical simulation, using only panel rows at or before the as-of:
+
+1. Daily steps (first differences for levels; log(1+r) for return targets). Steps that span a
+   data gap are dropped.
+2. The current variance is an EWMA (lambda {p['lam']}). It mean-reverts towards the long-run
+   variance (last {p['lr_window']} steps) at {p['phi']} per day over the horizon.
+3. Innovations are {p['block']}-day block bootstraps of whole-date standardised residual vectors.
+   Fat tails and cross-asset correlation come from the data, not from a Gaussian assumption.
+4. A per-draw common volatility multiplier (log-sd {p['volvol']}) carries parameter uncertainty.
+   The global width factor is {p['scale']}.
+5. Every horizon is read off the same simulated path, so cross-horizon dependence is coherent.
+
+| asset | anchor | current daily sd | long-run daily sd | daily drift |
+|---|---|---|---|---|
+{rows}
+
+Centre: the anchor is the last observation for levels, with no drift
+(fraction {p['level_drift']} of trailing mean). For return targets, the anchor is zero plus
+{p['ret_drift_shrink']} × the long-run mean log return per day.
+
+## What the text corpus contributed
+
+Nothing. {n_docs} document(s) were present and none was read. This entry is a calibrated
+statistical forecaster; no adjustment was inferred from tone or from memory of later events.
+
+## What would change this forecast
+
+A change in recent realised volatility (moves the width through the EWMA), or new panel data.
+"""
+
+
+def _safe_fallback(panels, assets, horizons, asof, n_draws, seed, target_type):
+    """Per-asset robust walk: last value (0 for returns), MAD-based step scale, step-count clock."""
+    rng = np.random.default_rng(seed)
+    hist = {}
+    for x in assets:
+        try:
+            hist[x] = _series(panels, x, asof)
+        except BaseException:
+            hist[x] = pd.Series(dtype=float)
+    out = np.empty((n_draws, len(assets), len(horizons)))
+    for i, x in enumerate(assets):
+        s = pd.to_numeric(hist[x], errors="coerce").dropna()
+        if target_type == "log_return":
+            st = np.log1p(s.clip(lower=-0.99)).iloc[-500:]
+            centre, unit = 0.0, (1.4826 * float(np.median(np.abs(st - st.median()))) if len(st) > 5 else 0.01)
+        else:
+            st = s.diff().dropna().iloc[-250:]
+            centre = float(s.iloc[-1]) if len(s) else 0.0
+            unit = 1.4826 * float(np.median(np.abs(st - st.median()))) if len(st) > 5 else 0.0
+            unit = unit or (float(st.abs().mean()) if len(st) else 0.0) or max(abs(centre) * 0.01, 1e-3)
+        gap = release.median_gap_days(s) if len(s) > 2 else 1.0
+        for j, h in enumerate(horizons):
+            steps = h if gap <= 4 else (1 if max(horizons) <= SHORT_MAX_H else max(1, round(h * 7 / 5 / gap)))
+            out[:, i, j] = centre + unit * 1.2 * np.sqrt(steps) * rng.standard_t(5, n_draws) * np.sqrt(3 / 5)
+    return out, {"engine": "fallback", "target_type": target_type}
+
+
