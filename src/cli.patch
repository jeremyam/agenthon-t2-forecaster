+def _dense_recent(hist: dict[str, pd.Series], asof: str) -> bool:
+    """True when every asset has dense daily history right up to the as-of.
+
+    Transfer cards (target withheld for years, single row at the as-of) and anything sparse go
+    to the reference walk, which already handles those shapes and passes the gates."""
+    cut = pd.Timestamp(asof) - pd.Timedelta(days=730)
+    for s in hist.values():
+        idx = pd.to_datetime(pd.Index(s.index).astype(str).str.slice(0, 10))
+        if len(idx) < 400 or (idx > cut).sum() < 400:
+            return False
+        if (pd.Timestamp(asof) - idx.max()).days > 10:
+            return False
+    return True
+
