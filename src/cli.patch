+def _norm_name(x: str) -> str:
+    """Case/punctuation-insensitive asset key (UST_3M == ust-3m == UST3M)."""
+    return "".join(ch for ch in str(x).upper() if ch.isalnum())
+
+
+#: Horizons at or below this many business days use the short-horizon FHS parameters and the
+#: relaxed density rule (Final ranked cards: 1-4 business days).
+SHORT_MAX_H = 10
+
+
+def _dense_recent_short(hist: dict[str, pd.Series], asof: str) -> bool:
+    """Short-horizon rule: >= 100 daily rows in the last 400 days and fresh at the as-of."""
+    cut = pd.Timestamp(asof) - pd.Timedelta(days=400)
+    for s in hist.values():
+        idx = pd.to_datetime(pd.Index(s.index).astype(str).str.slice(0, 10))
+        if (idx > cut).sum() < 100 or (pd.Timestamp(asof) - idx.max()).days > 10:
+            return False
+        if release.median_gap_days(s) > 4:
+            return False
+    return True
+
+
+def _release_k(hist: dict[str, pd.Series], assets: list[str], horizons: list[int]) -> np.ndarray:
+    """New prints per (asset, horizon): one per release inside a short window, else calendar-scaled."""
+    k = np.ones((len(assets), len(horizons)))
+    for i, a in enumerate(assets):
+        gap = max(release.median_gap_days(hist[a]), 1.0)
+        for j, h in enumerate(horizons):
+            if gap <= 4:          # daily series riding along on a release card: h business days
+                k[i, j] = max(h, 1)
+            elif max(horizons) <= SHORT_MAX_H:
+                k[i, j] = 1       # the card exists because one print lands in the window
+            else:
+                k[i, j] = max(1, round(h * 7 / 5 / gap))
+    return k
+
